{
  "expo": {
    "name": "PharmaShop",
    "slug": "pharmaShop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/pharmashop-app-icon.png",
    "scheme": "pharmashop",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/pharmashop-app-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/pharmashop-adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.refined.pharmashop",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/pharmashop-app-icon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-google-signin/google-signin",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-firebase/messaging",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./public/logo.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F3F7F5"
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.4.0"
          }
        }
      ],
      "expo-image",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "96eb3ded-91d7-420a-9102-04417aaf3d4e"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/96eb3ded-91d7-420a-9102-04417aaf3d4e"
    }
  }
}
